# Quotex Web Platform URL (use the active domain for your country/region, e.g. https://qxbroker.com)
QX_URL=https://qxbroker.com

# Browser profile directory (saves cookies, session tokens, and local storage locally)
USER_DATA_DIR=./qx_user_profile

# Path to system Google Chrome executable
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Launch browser in visible window (false = visible, true = headless)
HEADLESS=false

# Remote debugging port for attaching to dedicated Chrome
CHROME_REMOTE_DEBUG=9222

# Automatically close the dedicated bot Chrome window when the terminal closes (true/false)
CLOSE_CHROME_ON_EXIT=true

# Optional non-interactive & risk limit defaults:
# BOT_MODE=MANUAL
# BOT_ACCOUNT=DEMO
# ALLOW_OTC=true
# AUTO_STAKE=10
# AUTO_PROFIT_GOAL=100
# AUTO_MAX_SESSION_LOSS=40
# AUTO_MAX_DAILY_LOSS=60
# AUTO_MAX_TRADES=20
# AUTO_MAX_CONSEC_LOSSES=4
# PAIR_LOSS_COOLDOWN_STREAK=3
